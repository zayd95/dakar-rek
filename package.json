{
  "name": "dakar-rek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dakar Rek — open-world life sim set in Dakar (Three.js + TypeScript + Vite)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:online": "tsc --noEmit && vite build --mode online",
    "build:showcase": "tsc --noEmit && VITE_OWNER_SHOWCASE=1 vite build --config vite.artifact.config.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "dev:online": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm test && npm run typecheck:server && wrangler deploy",
    "check:online": "node scripts/check-multiplayer.mjs",
    "check:launch": "node scripts/check-launch-controls.mjs --full",
    "check:city": "node scripts/check-city-life.mjs",
    "check:chat": "node scripts/check-chat.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.169.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.148.0"
  }
}

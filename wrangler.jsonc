{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dakar-rek",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-07",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "CityRoom" },
    { "name": "LOBBIES", "class_name": "HubLobby" },
    // LD2.0-B: ONE class for the accounts (`acct:<tag>`) and the Teranga Money ledger (`ledger`): server/social.ts
    { "name": "SOCIAL", "class_name": "Social" },
    // 1.0.1 Grand Camp: ONE class for the matches (`camp:<match>`) and the districts' lists of lobbies (`list:<hub>`): server/camp.ts
    { "name": "CAMPS", "class_name": "GrandCamp" }
  ] },
  "migrations": [
    { "tag": "v1-presence", "new_sqlite_classes": ["CityRoom", "HubLobby"] },
    { "tag": "v2-social", "new_sqlite_classes": ["Social"] },
    // 1.0.1 Grand Camp. Applied to the public server only when the owner publishes 1.0.1.
    { "tag": "v3-grand-camp", "new_sqlite_classes": ["GrandCamp"] }
  ],
  // Worker Previews (Workers Builds on non-production branches, `wrangler preview`): each Preview gets its own
  // Durable Object namespace and storage, so test players never join production rooms.
  "previews": { "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "CityRoom" },
    { "name": "LOBBIES", "class_name": "HubLobby" },
    { "name": "SOCIAL", "class_name": "Social" },
    { "name": "CAMPS", "class_name": "GrandCamp" }
  ] } },
  "observability": { "enabled": true },
  "build": { "command": "npm run build:online" }
}
